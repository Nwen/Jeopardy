datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Grid {
  id        String   @id @default(cuid())
  name      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminConfig {
  id           Int    @id @default(1)
  passwordHash String
}
